{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 880,
  "height": 410,
  "autosize": {
    "type": "pad"
  },
  "background": "#faf8f2",
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#173b32",
      "titleColor": "#173b32",
      "gridColor": "#e3e5dc",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#173b32",
      "titleColor": "#173b32",
      "orient": "bottom"
    }
  },
  "vconcat": [
    {
      "width": 800,
      "height": 165,
      "title": {
        "text": "Opponent line breaks / match",
        "anchor": "start",
        "fontSize": 13,
        "color": "#173b32"
      },
      "data": {
        "url": "Data/site/defence.json"
      },
      "transform": [
        {
          "filter": {
            "field": "metric",
            "equal": "Opponent line breaks / match"
          }
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "line",
            "point": {
              "filled": true,
              "size": 65
            },
            "strokeWidth": 2.5
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative",
              "scale": {
                "domain": [
                  2022.85,
                  2025.7
                ],
                "nice": false,
                "zero": false
              },
              "axis": {
                "title": null,
                "values": [
                  2023,
                  2024,
                  2025
                ],
                "format": "d"
              }
            },
            "y": {
              "field": "value",
              "type": "quantitative",
              "axis": {
                "title": null
              },
              "scale": {
                "zero": true
              }
            },
            "color": {
              "field": "series",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Canterbury",
                  "League average"
                ],
                "range": [
                  "#17664d",
                  "#a1aaa4"
                ]
              },
              "legend": null
            },
            "strokeDash": {
              "field": "series",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Canterbury",
                  "League average"
                ],
                "range": [
                  [
                    1,
                    0
                  ],
                  [
                    5,
                    4
                  ]
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "series"
              },
              {
                "field": "year"
              },
              {
                "field": "metric"
              },
              {
                "field": "value"
              },
              {
                "field": "n"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year === 2023"
            },
            {
              "calculate": "format(datum.value, indexof(datum.metric,'metres') >= 0 ? '.0f' : '.2f')",
              "as": "label"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 8,
            "dy": {
              "expr": "datum.year === 2025 && datum.metric !== 'Missed tackles / match' ? (datum.series === 'Canterbury' ? 14 : -12) : (datum.series === 'Canterbury' ? -12 : 14)"
            },
            "fontSize": 11
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative",
              "scale": {
                "domain": [
                  2022.85,
                  2025.7
                ],
                "nice": false,
                "zero": false
              },
              "axis": {
                "title": null,
                "values": [
                  2023,
                  2024,
                  2025
                ],
                "format": "d"
              }
            },
            "y": {
              "field": "value",
              "type": "quantitative"
            },
            "color": {
              "field": "series",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Canterbury",
                  "League average"
                ],
                "range": [
                  "#17664d",
                  "#a1aaa4"
                ]
              },
              "legend": null
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year === 2025"
            },
            {
              "calculate": "datum.series + ' ' + format(datum.value, indexof(datum.metric,'metres') >= 0 ? '.0f' : '.2f')",
              "as": "label"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 8,
            "dy": {
              "expr": "datum.year === 2025 && datum.metric !== 'Missed tackles / match' ? (datum.series === 'Canterbury' ? 14 : -12) : (datum.series === 'Canterbury' ? -12 : 14)"
            },
            "fontSize": 11
