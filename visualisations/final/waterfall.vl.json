{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 880,
  "height": 370,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "#faf8f2",
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#173b32",
      "titleColor": "#173b32",
      "gridColor": "#e3e5dc",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#173b32",
      "titleColor": "#173b32",
      "orient": "bottom"
    }
  },
  "data": {
    "url": "Data/site/waterfall.json"
  },
  "encoding": {
    "x": {
      "field": "step",
      "type": "nominal",
      "sort": [
        "2023 balance",
        "More scored",
        "Fewer conceded",
        "2025 balance"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelExpr": "split(datum.label,' ')"
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.order < 3"
        },
        {
          "calculate": "['More scored','Fewer conceded','2025 balance'][datum.order]",
          "as": "next"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#a1aaa4",
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x2": {
          "field": "next"
        },
        "y": {
          "field": "end",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "size": {
          "expr": "max(30,width/7)"
        }
      },
      "encoding": {
        "y": {
          "field": "start",
          "type": "quantitative",
          "title": "Season point difference"
        },
        "y2": {
          "field": "end"
        },
        "color": {
          "condition": {
            "test": "datum.kind === 'Change'",
            "value": "#17664d"
          },
          "value": "#b65734"
        },
        "tooltip": [
          {
            "field": "step"
          },
          {
            "field": "value"
          },
          {
            "field": "start"
          },
          {
            "field": "end"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -12,
        "fontWeight": "bold",
        "fontSize": 15,
        "color": "#173b32"
      },
      "encoding": {
        "y": {
          "field": "end",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
